<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AjulBisik_Hutspeng"
             xmlns:helpers="clr-namespace:AjulBisik_Hutspeng.Helpers"
             x:Class="AjulBisik_Hutspeng.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Converters -->
            <helpers:NextButtonTextConverter x:Key="NextButtonTextConverter" />
            <helpers:NullToBoolConverter x:Key="NullToBoolConverter" />
            <helpers:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <helpers:BoolToImageConverter x:Key="BoolToImageConverter" />
            <helpers:PrimarySoftToGrayConverter x:Key="PrimarySoftToGrayConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
