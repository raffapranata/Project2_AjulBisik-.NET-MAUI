<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AjulBisik_Hutspeng.Views.ForgotPasswordPage"
             xmlns:viewmodels="clr-namespace:AjulBisik_Hutspeng.ViewModels"
             x:DataType="viewmodels:ForgotPasswordViewModel"
             Title="Lupa Password">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            
            <Image Source="logo.svg" HeightRequest="100" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <Label Text="Atur Ulang Password" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="{StaticResource Primary}"/>

            <!-- Step 1: Request OTP -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding IsRequestingOtp}">
                <Label Text="Masukkan email Anda yang terdaftar. Kami akan mengirimkan OTP untuk memverifikasi." 
                       FontSize="14" 
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                
                <Frame BorderColor="{StaticResource Gray200}" CornerRadius="10" Padding="0" HasShadow="False">
                    <Entry Text="{Binding Email}" 
                           Placeholder="Email" 
                           Keyboard="Email"
                           Margin="10,0"/>
                </Frame>
                
                <Button Text="Kirim OTP" 
                        Command="{Binding RequestOtpCommand}" 
                        Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <!-- Step 2: Reset Password (after OTP verified) -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding IsOtpVerified}">
                <Label Text="Silakan masukkan password baru Anda." 
                       FontSize="14" 
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                
                <Frame BorderColor="{StaticResource Gray200}" CornerRadius="10" Padding="0" HasShadow="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Text="{Binding NewPassword}" 
                               Placeholder="Password Baru" 
                               IsPassword="{Binding IsPasswordHidden}"
                               Margin="10,0" Grid.Column="0"/>
                        <ImageButton Source="{Binding IsPasswordHidden, Converter={StaticResource BoolToImageConverter}}" 
                                     Command="{Binding TogglePasswordCommand}"
                                     BackgroundColor="Transparent"
                                     WidthRequest="24" HeightRequest="24"
                                     Margin="0,0,10,0" Grid.Column="1"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="{StaticResource Gray200}" CornerRadius="10" Padding="0" HasShadow="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Text="{Binding ConfirmNewPassword}" 
                               Placeholder="Konfirmasi Password Baru" 
                               IsPassword="{Binding IsConfirmPasswordHidden}"
                               Margin="10,0" Grid.Column="0"/>
                        <ImageButton Source="{Binding IsConfirmPasswordHidden, Converter={StaticResource BoolToImageConverter}}" 
                                     Command="{Binding ToggleConfirmPasswordCommand}"
                                     BackgroundColor="Transparent"
                                     WidthRequest="24" HeightRequest="24"
                                     Margin="0,0,10,0" Grid.Column="1"/>
                    </Grid>
                </Frame>

                <Button Text="Simpan Password Baru" 
                        Command="{Binding ResetPasswordCommand}" 
                        Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
