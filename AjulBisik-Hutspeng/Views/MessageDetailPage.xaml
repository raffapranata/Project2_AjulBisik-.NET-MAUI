<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AjulBisik_Hutspeng.Views.MessageDetailPage"
             Title="Detail Pesan">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Pesan Card (This is what will be shared) -->
            <Border x:Name="MessageCard" Padding="20" Stroke="Transparent" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <!-- Sender Info -->
                    <Grid ColumnDefinitions="50,*" ColumnSpacing="15">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 25" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" VerticalOptions="Start" Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimarySoft}}" StrokeThickness="2">
                            <Image Source="{Binding SenderProfilePhoto}" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Message.Sender.FullName}" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource PrimarySoft}}" />
                            <Label Text="{Binding Message.Sender.Username}" TextColor="Gray" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="LightGray" />

                    <!-- Content -->
                    <Label Text="{Binding Message.Content}" FontSize="18" LineHeight="1.5" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

                    <!-- Reaction Badge (Visible on card/share) -->
                    <Border IsVisible="{Binding HasReaction}" 
                            HorizontalOptions="Start" 
                            Padding="8,4" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}" 
                            StrokeShape="RoundRectangle 15" 
                            Stroke="Transparent">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{Binding Message.Reaction}" FontSize="16" VerticalOptions="Center" />
                            <Label Text="Reaksi" FontSize="11" TextColor="Gray" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Reply Display -->
                    <Border IsVisible="{Binding HasReply}" Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}" StrokeShape="RoundRectangle 10" Stroke="Transparent">
                        <VerticalStackLayout>
                            <Label Text="Balasan Anda:" FontSize="12" TextColor="Gray" Margin="0,0,0,5" />
                            <Label Text="{Binding Message.ReplyContent}" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Branding (visible on share) -->
                    <Label x:Name="WatermarkLabel" Text="dikirim via AjulBisik" FontSize="12" TextColor="Gray" HorizontalOptions="Center" Margin="0,10,0,0" IsVisible="{Binding IsSharing}" />
                </VerticalStackLayout>
            </Border>

            <!-- Reactions -->
            <Label Text="Beri Reaksi" FontSize="16" FontAttributes="Bold" />
            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start">
                <Button Text="❤️" Command="{Binding ReactCommand}" CommandParameter="❤️" BackgroundColor="Transparent" FontSize="24" />
                <Button Text="😂" Command="{Binding ReactCommand}" CommandParameter="😂" BackgroundColor="Transparent" FontSize="24" />
                <Button Text="😢" Command="{Binding ReactCommand}" CommandParameter="😢" BackgroundColor="Transparent" FontSize="24" />
                <Button Text="🔥" Command="{Binding ReactCommand}" CommandParameter="🔥" BackgroundColor="Transparent" FontSize="24" />
            </FlexLayout>
            <Label Text="{Binding CurrentReactionText}" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimarySoft}}" FontAttributes="Bold" IsVisible="{Binding HasReaction}" />

            <!-- Reply Input -->
            <Label Text="Balas Pesan" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />
            <Editor Placeholder="Tulis balasan..." Text="{Binding ReplyInput}" HeightRequest="100" />
            <Button Text="Simpan Balasan" Command="{Binding SaveReplyCommand}" CornerRadius="10" />

            <!-- Share Button -->
            <Button Text="Bagikan ke Sosial Media" Command="{Binding ShareCommand}" CommandParameter="{Reference MessageCard}" BackgroundColor="{StaticResource Magenta}" CornerRadius="10" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
