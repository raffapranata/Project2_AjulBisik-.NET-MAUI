<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AjulBisik_Hutspeng.Views.VerifyOtpPage"
             xmlns:viewmodels="clr-namespace:AjulBisik_Hutspeng.ViewModels"
             x:DataType="viewmodels:VerifyOtpViewModel"
             Title="Verifikasi OTP">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            
            <Image Source="logo.svg" HeightRequest="100" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <Label Text="Verifikasi Email Anda" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="{StaticResource Primary}"/>

            <Label Text="{Binding MessageText}" 
                   FontSize="14" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>

            <Frame BorderColor="{StaticResource Gray200}" CornerRadius="10" Padding="0" HasShadow="False">
                <Entry Text="{Binding OtpCode}" 
                       Placeholder="Masukkan 6 Digit OTP" 
                       Keyboard="Numeric"
                       MaxLength="6"
                       Margin="10,0"/>
            </Frame>

            <Button Text="Verifikasi" 
                    Command="{Binding VerifyOtpCommand}" 
                    Margin="0,10,0,0"/>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Button Text="Kirim Ulang OTP" 
                        Command="{Binding ResendOtpCommand}" 
                        IsEnabled="{Binding CanResend}"
                        Style="{StaticResource TextButton}"/>
                <Label Text="{Binding TimerText}" 
                       VerticalOptions="Center"
                       IsVisible="{Binding CanResend, Converter={StaticResource InvertedBoolConverter}}"
                       TextColor="Gray"/>
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
