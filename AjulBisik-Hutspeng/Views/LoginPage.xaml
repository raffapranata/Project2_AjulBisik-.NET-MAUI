<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AjulBisik_Hutspeng.Views.LoginPage"
             NavigationPage.HasNavigationBar="False">
    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
        <Image Source="logo.png" HeightRequest="80" HorizontalOptions="Center" Margin="0,0,0,10" />
        <Label Text="AJUL BISIK" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Masuk ke akunmu" FontSize="16" HorizontalOptions="Center" TextColor="Gray" Margin="0,0,0,20"/>
        
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" TextTransform="Lowercase" />
        
        <Grid ColumnDefinitions="*,Auto">
            <Entry Placeholder="Kata Sandi" Text="{Binding Password}" IsPassword="{Binding IsPasswordHidden}" Grid.Column="0" />
            <ImageButton Command="{Binding TogglePasswordCommand}" BackgroundColor="Transparent" Grid.Column="1" WidthRequest="20" HeightRequest="20" Margin="10,5" Aspect="AspectFit">
                <ImageButton.Triggers>
                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsPasswordHidden}" Value="True">
                        <Setter Property="Source" Value="ic_eye_closed.png" />
                    </DataTrigger>
                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsPasswordHidden}" Value="False">
                        <Setter Property="Source" Value="ic_eye_open.png" />
                    </DataTrigger>
                </ImageButton.Triggers>
            </ImageButton>
        </Grid>
        
        <Button Text="Lupa Kata Sandi?" Command="{Binding GoToForgotPasswordCommand}" BackgroundColor="Transparent" TextColor="Gray" HorizontalOptions="End" FontSize="12" Margin="0,-10,0,0"/>
        
        <Button Text="Masuk" Command="{Binding LoginCommand}" CornerRadius="10" Margin="0,20,0,0"/>
        
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
            <Label Text="Belum punya akun?" VerticalOptions="Center" />
            <Button Text="Daftar" Command="{Binding GoToRegisterCommand}" BackgroundColor="Transparent" TextColor="Blue" />
        </HorizontalStackLayout>
        
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>
